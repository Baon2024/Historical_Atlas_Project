{
  "name": "historical-polities-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-map.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-map.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components context lib scripts tests next.config.ts playwright.config.ts postcss.config.mjs tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check app components context lib scripts tests next.config.ts playwright.config.ts postcss.config.mjs tsconfig.json package.json .prettierrc.json"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/maplibre": "9.4.1",
    "@deck.gl/react": "9.4.1",
    "lucide-react": "1.67.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@math.gl/polygon": "4.1.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "world-atlas": "2.0.2"
  }
}
